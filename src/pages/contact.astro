---
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/data';
const site = loadSite();
const [first, ...rest] = site.contact;
---
<Base
  title="Contact. Chris Ampadu"
  description="How to reach Chris Ampadu: email first, then GitHub. Personal, non-commercial portfolio; write about the work and the method."
  path="/contact/"
  current="/contact/"
>
  <div class="contact wrap" data-src="site.yml">
    <p class="kicker">Contact</p>
    <h1>Write to me.</h1>
    <p><a class="mail" href={first.href}>{first.label}</a></p>
    <p class="lede">This is my personal, non-commercial portfolio. You are welcome to write to me about the work and the method shown here.</p>
    {site.location && <p class="kicker where">{site.location}</p>}
    {rest.length > 0 && <p class="links">{rest.map((c) => <a href={c.href}>{c.label}</a>)}</p>}
  </div>
</Base>
